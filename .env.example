# Host ports the docker-compose stack publishes. Copy to .env and edit only if one of
# these is already taken on your machine — a local Postgres on 5432 is the usual culprit,
# and it will shadow the container without any obvious error.
#
#   cp .env.example .env
#
# Point the application at the same ports when you change them:
#   POSTGRES_URL=jdbc:postgresql://localhost:55432/notifications ./mvnw spring-boot:run

POSTGRES_PORT=5432
IGNITE_PORT=10800
KAFKA_PORT=9092
